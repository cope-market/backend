# Privy. The app ID is public - it ships inside client bundles - so it is committed here.
# The app SECRET is not, and is required for server-side token verification.
PRIVY_APP_ID=cmtydcbsd02f00cjkdaadli5p
PRIVY_APP_SECRET=

# Database. Any Postgres; see PLAN.md for the hosting decision.
DATABASE_URL=postgres://cope:cope@localhost:5432/cope

# Chain. Addresses are for Arc testnet; see the contracts repo for the current deployment.
ARC_RPC_URL=https://rpc.testnet.arc.io
SYNTHETIC_VAULT_ADDRESS=0x2c720283A8Bbb5CC5b13C0C4Bcf2300826286c47
LIQUIDITY_VAULT_ADDRESS=0x0ffABC4e80125C5742D5ed04Cc1fD1b634Bc3C5d
ORACLE_ADDRESS=0x0f2d191fEC3bB2DEEd8cE3E326193fd9b5203277
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# The Cope Market subgraph. Positions, the copy graph and realised P&L: everything the backend
# cannot derive from its own tables. No API key is needed at a Studio query URL.
COPE_SUBGRAPH_URL=https://api.studio.thegraph.com/query/101383/cope-market-arc/v0.2.0

# Pyth Hermes, for the price pusher. Entitled to four feeds; see the contracts repo SPIKE.md.
PYTH_API_KEY=
